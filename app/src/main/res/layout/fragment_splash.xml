<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/_27sdp">

    <TextView
        android:id="@+id/om"
        android:layout_width="@dimen/_133sdp"
        android:layout_height="@dimen/_133sdp"
        android:background="@drawable/bg_om"
        android:gravity="center"
        android:text="ॐ"
        android:textColor="@color/white"
        android:textSize="54sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:text="श्रीमद्भगवद्गीता"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/sanskrit" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

    <View
        android:layout_width="@dimen/_53sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/bg_gold_line" />

    <TextView
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:gravity="center"
        android:text="योगस्थः कुरु कर्माणि सङ्गं त्यक्त्वा धनञ्जय" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="@dimen/_117sdp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_30sdp"
        android:indeterminate="true"
        app:indicatorColor="@color/saffron"
        app:trackColor="@color/gold_light" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:gravity="center"
        android:textColor="@color/favorite"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/retryButton"
        style="@style/Widget.DivineGita.PillButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:text="@string/try_again"
        android:visibility="gone" />
</LinearLayout>
