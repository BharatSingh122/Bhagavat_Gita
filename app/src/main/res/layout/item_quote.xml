<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_3sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/_11sdp"
        android:paddingTop="@dimen/_10sdp"
        android:paddingEnd="@dimen/_9sdp"
        android:paddingBottom="@dimen/_6sdp">

        <TextView
            android:id="@+id/category"
            style="@style/Text.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_4sdp" />

        <ImageView
            android:layout_width="@dimen/_26sdp"
            android:layout_height="@dimen/_26sdp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_quote"
            app:tint="@color/gold" />

        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="6sp"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:textSize="@dimen/text_reading" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_7sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_2sdp"
                android:background="@drawable/bg_gold_line" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_weight="1"
                android:text="श्रीमद्भगवद्गीता"
                android:textColor="@color/sanskrit"
                android:textSize="@dimen/text_caption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/favorite"
                style="@style/Widget.DivineGita.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/favorite"
                app:icon="@drawable/ic_favorite_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/copy"
                style="@style/Widget.DivineGita.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/copy"
                app:icon="@drawable/ic_copy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/share"
                style="@style/Widget.DivineGita.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/share"
                app:backgroundTint="@color/saffron"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
