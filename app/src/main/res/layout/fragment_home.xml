<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/_11sdp"
        android:paddingEnd="@dimen/_11sdp"
        android:paddingBottom="@dimen/_11sdp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:background="@drawable/bg_om"
                android:gravity="center"
                android:text="ॐ"
                android:textColor="@color/white"
                android:textSize="@dimen/text_om_small"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_7sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Text.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sanatan Dharma" />

                <TextView
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bhagavad Gita" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                style="@style/Widget.DivineGita.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/settings"
                app:icon="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Sloka of the Day -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dailyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_11sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_11sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_date_badge"
                        android:gravity="center_horizontal"
                        android:minWidth="@dimen/_56sdp"
                        android:orientation="vertical"
                        android:padding="@dimen/_6sdp">

                        <TextView
                            android:id="@+id/dateDay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/saffron_deep"
                            android:textSize="@dimen/text_display_small"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/dateMonthYear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/dateWeekday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceLabelSmall"
                            android:textColor="@color/sanskrit" />

                        <View
                            android:layout_width="@dimen/_18sdp"
                            android:layout_height="@dimen/_2sdp"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:background="@drawable/bg_gold_line" />
                    </LinearLayout>

                    <TextView
                        style="@style/Text.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_weight="1"
                        android:text="@string/sloka_of_day" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dailyFavorite"
                        style="@style/Widget.DivineGita.IconButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:contentDescription="@string/favorite"
                        app:icon="@drawable/ic_favorite_border" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dailySanskrit"
                    style="@style/Text.Sanskrit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_9sdp"
                    android:ellipsize="end"
                    android:maxLines="6"
                    android:text="@string/preparing" />

                <TextView
                    android:id="@+id/dailyTranslation"
                    style="@style/Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:ellipsize="end"
                    android:maxLines="3" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_7sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dailyReference"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:drawablePadding="@dimen/_4sdp"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="@color/text_secondary"
                        app:drawableStartCompat="@drawable/ic_book"
                        app:drawableTint="@color/saffron" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/readMoreButton"
                        style="@style/Widget.DivineGita.PillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/read_more"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="textEnd"
                        app:iconSize="@dimen/_11sdp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Mood ribbon -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/moodRibbon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_mood_ribbon"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/_10sdp">

                <ImageView
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:background="@drawable/bg_circle_white"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/_7sdp"
                    android:src="@drawable/ic_mood"
                    app:tint="@color/saffron_deep" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_9sdp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gita for guidance" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Feeling anxious or confused?"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="@color/dark_brown"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Seek Krishna's eternal solace for inner peace"
                        android:textColor="#5D4037"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/saffron_deep" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Category cards -->
        <include android:id="@+id/cardGita" layout="@layout/view_category_card" />
        <include android:id="@+id/cardQuotes" layout="@layout/view_category_card" />
        <include android:id="@+id/cardChalisa" layout="@layout/view_category_card" />
        <include android:id="@+id/cardMood" layout="@layout/view_category_card" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
