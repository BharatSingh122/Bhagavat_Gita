<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:layout_width="@dimen/_120sdp"
        android:layout_height="@dimen/_120sdp"
        android:background="@drawable/bg_om"
        android:gravity="center"
        android:text="ॐ"
        android:textColor="@color/white"
        android:textSize="@dimen/text_om_large"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/overline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20sdp"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="@color/sanskrit" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

    <View
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_3sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:background="@drawable/bg_gold_line" />

    <TextView
        android:id="@+id/body"
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_9sdp"
        android:gravity="center"
        android:textSize="@dimen/text_body_large" />

    <TextView
        android:id="@+id/highlights"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:background="@drawable/bg_date_badge"
        android:lineSpacingExtra="6sp"
        android:padding="@dimen/_10sdp"
        android:textColor="@color/text_primary" />
</LinearLayout>
