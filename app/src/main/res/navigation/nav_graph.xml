<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment android:id="@+id/splashFragment" android:name="com.divine.gita.ui.splash.SplashFragment">
        <action android:id="@+id/action_splash_to_home" app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment" app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in" app:exitAnim="@anim/fade_out" />
        <action android:id="@+id/action_splash_to_onboarding" app:destination="@id/onboardingFragment"
            app:popUpTo="@id/splashFragment" app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in" app:exitAnim="@anim/fade_out" />
    </fragment>

    <fragment android:id="@+id/onboardingFragment" android:name="com.divine.gita.ui.onboarding.OnboardingFragment">
        <action android:id="@+id/action_onboarding_to_home" app:destination="@id/homeFragment"
            app:popUpTo="@id/onboardingFragment" app:popUpToInclusive="true"
            app:enterAnim="@anim/fade_in" app:exitAnim="@anim/fade_out" />
    </fragment>

    <fragment android:id="@+id/homeFragment" android:name="com.divine.gita.ui.home.HomeFragment" />
    <fragment android:id="@+id/chaptersFragment" android:name="com.divine.gita.ui.chapters.ChaptersFragment" />

    <fragment android:id="@+id/chapterDetailFragment" android:name="com.divine.gita.ui.chapters.ChapterDetailFragment">
        <argument android:name="chapterNumber" app:argType="integer" />
    </fragment>

    <fragment android:id="@+id/slokaDetailFragment" android:name="com.divine.gita.ui.sloka.SlokaDetailFragment">
        <argument android:name="slokaId" app:argType="integer" />
    </fragment>

    <fragment android:id="@+id/quotesFragment" android:name="com.divine.gita.ui.quotes.QuotesFragment" />
    <fragment android:id="@+id/chalisaListFragment" android:name="com.divine.gita.ui.chalisa.ChalisaListFragment" />

    <fragment android:id="@+id/chalisaDetailFragment" android:name="com.divine.gita.ui.chalisa.ChalisaDetailFragment">
        <argument android:name="chalisaId" app:argType="integer" />
    </fragment>

    <fragment android:id="@+id/moodFragment" android:name="com.divine.gita.ui.mood.MoodFragment" />

    <fragment android:id="@+id/moodVersesFragment" android:name="com.divine.gita.ui.mood.MoodVersesFragment">
        <argument android:name="moodKey" app:argType="string" />
    </fragment>

    <fragment android:id="@+id/favoritesFragment" android:name="com.divine.gita.ui.favorites.FavoritesFragment" />
    <fragment android:id="@+id/settingsFragment" android:name="com.divine.gita.ui.settings.SettingsFragment" />
</navigation>
